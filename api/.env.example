# GuardRail AI - Environment Configuration

# Server
NODE_ENV=production
PORT=3001
FRONTEND_URL=http://localhost:3000

# Local Ollama and persistence
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=rafw007/qwen35-claude-coder:4b
OLLAMA_TIMEOUT_MS=120000
GUARDRAIL_MAX_FINDINGS=10
GUARDRAIL_DATA_DIR=./data/local

# Rate limiting for API write requests (GET/HEAD/OPTIONS are not counted)
RATE_LIMIT=50

# Security
SESSION_TTL_HOURS=24
MAX_FILE_SIZE_MB=1

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_TOKEN=your_github_token

# Local webhook notifications are disabled by default.
LOCAL_NOTIFICATIONS=false
